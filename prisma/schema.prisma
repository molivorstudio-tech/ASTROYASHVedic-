datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// NextAuth.js Standard Adapter Models (Phase 2b)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials authentication
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  charts        Chart[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// Content Engine Models (Phase 2d)
// ------------------------------------------------------

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio       String?  @db.Text
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id                   String    @id @default(cuid())
  title                String
  slug                 String    @unique
  category             String
  excerpt              String    @db.Text
  publishedAt          DateTime? // null = draft
  readTime             String
  body                 String    @db.Text
  pullQuote            String?   @db.Text
  pullQuoteAttribution String?
  gradient             String?
  authorId             String
  author               Author    @relation(fields: [authorId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ------------------------------------------------------
// User Accounts & Chart Storage (Phase 2c & Phase 4)
// ------------------------------------------------------

model Chart {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate  DateTime
  birthTime  String?  // null if exact birth time is unknown
  birthPlace String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
